FROM golang:1.23.12-alpine3.22 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/sim-api ./cmd/sim-api \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/sim-migrate ./cmd/sim-migrate

FROM alpine:3.22

RUN apk add --no-cache ca-certificates wget \
    && addgroup -S -g 10001 timon \
    && adduser -S -D -H -u 10001 -G timon timon
WORKDIR /app
COPY --from=build /out/sim-api /app/sim-api
COPY --from=build /out/sim-migrate /app/sim-migrate
USER 10001:10001
EXPOSE 8182
ENTRYPOINT ["/app/sim-api"]
