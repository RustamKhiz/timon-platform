[Unit]
Description=TIMON SIM Telegram Bot (closed mock staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=timon-sim
Group=timon-sim
WorkingDirectory=/opt/timon-platform/bot/current
EnvironmentFile=/opt/timon-platform/bot/shared/.env
Environment=TELEGRAM_OFFSET_FILE=/var/lib/timon-sim-bot/update.offset
ExecStart=/opt/timon-platform/bot/current/sim-bot
Restart=always
RestartSec=5
TimeoutStopSec=20
StateDirectory=timon-sim-bot
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/timon-sim-bot
MemoryMax=128M
CPUQuota=25%
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
