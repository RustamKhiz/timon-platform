[Unit]
Description=TIMON SIM API SSH tunnel (NL bot to Timeweb loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=timon-sim
Group=timon-sim
ExecStart=/usr/bin/ssh -N -T -i /etc/timon-sim/api-tunnel -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/timon-sim/known_hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:18082:127.0.0.1:8182 deploy@109.196.100.71
Restart=always
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=64M
CPUQuota=10%
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
