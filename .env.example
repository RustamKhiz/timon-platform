SIM_API_ADDR=127.0.0.1:18080
SIM_API_URL=http://127.0.0.1:18080
SIM_API_TOKEN=
SIM_DATABASE_URL=
SIM_FIXED_MARKUP_RUB=100
SIM_EXPECTED_PAYMENT_FEE_BPS=350
SIM_PROVIDER_MODE=mock
# Optional outage fallback. Normal sandbox pricing loads the latest CBR rate automatically.
SIM_USD_RUB_RATE=
SIM_FX_BUFFER_BPS=500
# Optional SIM admin. Set all three values together. Keep the bcrypt hash and
# the 32+ character session secret outside Git in real environments.
SIM_ADMIN_USERNAME=
SIM_ADMIN_PASSWORD_BCRYPT=
SIM_ADMIN_SESSION_SECRET=
SIM_ADMIN_COOKIE_SECURE=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_OFFSET_FILE=

# Keepgo sandbox catalogue probe. Keep real values only in an ignored local env
# file or the process environment; never commit either credential.
KEEPGO_BASE_URL=https://myaccount.sandbox.keepgo.com/api/v2
KEEPGO_API_KEY=
KEEPGO_ACCESS_TOKEN=
KEEPGO_COUNTRIES=Turkey,Egypt,United Arab Emirates,India,Thailand,Vietnam,China
